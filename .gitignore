# ============================================================
# .gitignore - Agriculture Yield GPU Pipeline
# ============================================================

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.pyo
*.pyd

# ── Jupyter ───────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints
profile_default/
ipython_config.py
# NE PAS ignorer les notebooks eux-mêmes :
# !agriculture_yield_pipeline.ipynb

# ── Environnements virtuels ───────────────────────────────
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.conda/

# ── Données (souvent trop volumineuses pour git) ──────────
data/
*.csv
*.parquet
*.h5
*.hdf5
*.pkl
*.pickle
# Sauf les petits fichiers de config/sample :
!data/sample_fao.csv

# ── Modèles entraînés ─────────────────────────────────────
models/
*.joblib
*.cbm
*.xgb
*.json
# Sauf configs :
!config*.json
!requirements*.json

# ── Graphiques / outputs ──────────────────────────────────
outputs/
plots/
figures/
*.png
*.jpg
*.jpeg
*.svg
*.pdf
# Sauf les images du README :
!assets/

# ── Logs ──────────────────────────────────────────────────
logs/
*.log
*.out

# ── OS ────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDEs ──────────────────────────────────────────────────
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ── Colab spécifique ──────────────────────────────────────
rapidsai-csp-utils/
drive/
sample_data/

# ── Secrets / credentials ─────────────────────────────────
.env
*.key
secrets.json
kaggle.json
credentials.json

# ── Compilé / cache ───────────────────────────────────────
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
